    {
      "id": "8775d34c-0bdd-40a2-9481-e9b2c2304362",
      "name": "Step Failed",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1900,
        900
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "language": "javaScript",
        "jsCode": "const step = $('Loop Steps').first().json;\nconst err = $input.first().json.error;\nconst msg = String((err && (err.message || err.description)) || err || 'неизвестная ошибка').slice(0, 500);\nconst esc = t => String(t).replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;');\nconst text = '❌ <b>Ошибка: ' + esc(step.stepName) + '</b>' + (step.dryRun ? ' (тестовый режим)' : '') +\n  '\\n' + esc(msg) + '\\nСледующие шаги не запускались. Подробности — в журнале запусков n8n на ПК.';\nconst ids = [...new Set([step.chatId, '<OWNER_TELEGRAM_CHAT_ID>'].filter(Boolean))];\nreturn ids.map(chatId => ({ json: { chatId, text: (chatId !== step.chatId && step.requestedBy ? '👤 Запустил: ' + esc(step.requestedBy) + '\\n' : '') + text } }));"
      }
