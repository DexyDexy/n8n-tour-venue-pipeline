    {
      "id": "675c68f6-329d-488a-8589-b432ac65e010",
      "name": "Report",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        2700,
        450
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "language": "javaScript",
        "jsCode": "const s = $('Settings').first().json;\nconst target = $('Target Folder').first().json.targetPath;\nconst res = $input.all().map(i => i.json).filter(r => r.fileName);\nconst sum = k => res.reduce((a, r) => a + (r[k] || 0), 0);\nconst errors = res.filter(r => r.status !== 'ok');\nconst esc = t => String(t).replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;');\nconst lines = [];\nlines.push('<b>Tour Venues: баннеры обработаны</b>' + (s.dryRun ? ' (тестовый режим, без записи)' : ''));\nif (!res.length) lines.push('Новых баннеров в папке нет.');\nelse {\n  lines.push('Баннеров: ' + res.length + (errors.length ? ', с ошибкой: ' + errors.length : ''));\n  lines.push('Концертов найдено: ' + sum('found'));\n  lines.push((s.dryRun ? 'Было бы добавлено' : 'Добавлено в таблицу') + ': ' + (s.dryRun ? sum('wouldAdd') : sum('added')));\n  lines.push('Дубли пропущены: ' + sum('duplicates'));\n  if (sum('noVenue')) lines.push('Без NAME (не внесены): ' + sum('noVenue'));\n  if (!s.dryRun) lines.push('Перенесено в ' + esc(target) + ': ' + res.filter(r => r.moved).length);\n  for (const e of errors.slice(0, 10)) lines.push('⚠️ ' + esc(e.fileName) + ': ' + esc(e.error));\n  if (errors.length) lines.push('Баннеры с ошибкой остались во входящей папке.');\n}\nreturn [{ json: { text: lines.join('\\n'), banners: res.length, found: sum('found'), added: sum('added'), duplicates: sum('duplicates'), noVenue: sum('noVenue'), errors: errors.length, details: res } }];"
      }
    },
    {
      "id": "a7a15a9e-5471-4c18-b6b4-190fd0a13151",
      "name": "Download Banner",
      "type": "n8n-nodes-base.googleDrive",
      "typeVersion": 3,
      "position": [
        3100,
        300
      ],
      "parameters": {
        "authentication": "serviceAccount",
