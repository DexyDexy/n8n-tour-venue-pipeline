    {
      "id": "570d8078-f797-4629-beb7-0ed9fd2f8692",
      "name": "Select Files",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        2300,
        300
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "language": "javaScript",
        "jsCode": "// Баннеры по имени (скриншоты называются по времени — получается по порядку съёмки)\nconst s = $('Settings').first().json;\nconst files = $input.all().map(i => i.json).filter(f => f.id && /^image\\//.test(f.mimeType || ''))\n  .sort((a, b) => String(a.name).localeCompare(String(b.name), 'en', { numeric: true }))\n  .slice(0, s.maxFiles);\nreturn [{ json: { count: files.length, files } }];"
      }
    },
